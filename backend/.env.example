# Port the API listens on
PORT=3010

# MongoDB connection string. Leave empty to run in demo mode (deterministic generated data).
# Example: mongodb+srv://user:pass@cluster.mongodb.net/RQ_Analytics
MONGODB_URI=

# Optional: OpenCage API key for server-side geocoding of cities that are not in the bundled table.
OPENCAGE_API_KEY=

# How often (minutes) to reload the collections from MongoDB
REFRESH_MINUTES=10

# Seed for the demo dataset generator (any integer)
DEMO_SEED=42

# Allowed CORS origin(s). "*" or a comma separated list.
CORS_ORIGIN=*
